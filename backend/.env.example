# ===== 复制本文件为 backend/.env 并填入真实值（.env 已被 .gitignore 忽略，禁止提交）=====

# ===== 数据库（低权账号，仅 SELECT/INSERT/UPDATE/DELETE，禁 DDL）=====
DB_USERNAME=sms_app
DB_PASSWORD=change-me-in-production

# ===== JWT 签名密钥（必须与 backend-ai/.env 的 JWT_SECRET 保持一致）=====
JWT_SECRET=replace-with-the-same-secret-as-backend-ai

# ===== GitHub OAuth 应用凭据（https://github.com/settings/developers）=====
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ===== AI 服务地址（Spring relaxed binding 需用 AI_BASEURL，不带下划线）=====
AI_BASEURL=http://localhost:8000

# ===== 百度天气 AK（https://lbsyun.baidu.com/apiconsole/key）=====
BAIDU_WEATHER_AK=your-baidu-weather-ak
