# ===== DeepSeek 官方（对话模型，OpenAI 兼容接口）=====
# 在 https://platform.deepseek.com/ 创建 API Key 后填入
# DEEPSEEK_API_KEY 必填：服务启动时会校验，未配置将拒绝启动
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 硅基流动 SiliconFlow（向量检索 embedding / rerank，仅选课建议使用）=====
# 在 https://console.siliconflow.cn/ 创建 API Key 后填入；不填则选课建议不可用，主问答不受影响
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== AI 模型 =====
# 对话模型：DeepSeek 官方（deepseek-v4-flash / deepseek-v4-pro）
LLM_MODEL=deepseek-v4-flash
# 向量模型（SiliconFlow）
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== MySQL（只读）=====
# MYSQL_PASSWORD 必填：服务启动时会校验，未配置将拒绝启动
# 生产环境请使用独立最小权限账号（见 sql/create_app_user.sql，如 sms_app，仅授 student_management 库 CRUD）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sms_app
MYSQL_PASSWORD=change-me-in-production
MYSQL_DB=student_management

# ===== JWT 验证 =====
# 与 Spring 后端 application.yml 的 jwt.secret 保持一致（环境变量 JWT_SECRET）
# AI 服务仅接受携带有效 Bearer JWT 的请求，用于校验 Spring 转发来的身份
JWT_SECRET=replace-with-the-same-secret-as-backend

# ===== 服务配置 =====
# ChromaDB 本地持久化目录
CHROMA_DIR=./chroma
# LLM 最大输出 token
LLM_MAX_TOKENS=1500
# AI 服务监听端口（默认 8000，若被占用可改为其它端口并同步 Spring 端 AI_BASE_URL）
AI_PORT=8000
# 是否启用 /docs 交互文档（默认 false 关闭；仅本机调试可设为 true）
ENABLE_DOCS=false
